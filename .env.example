# Copy to .env and fill in. .env is gitignored - never commit real values.

# Password for the PropNex sales API, used to fetch the ground-truth record
# for a Sale No. Without it the app can still extract, but has nothing to
# compare against.
STAGING_API_PASSWORD=

# Optional. Sales API endpoint. Defaults to the staging endpoint in
# app/groundtruth.py; set this to point at a different environment.
# LOF2DATA_API_URL=https://staging.mypropnex.com/api/sales/details

# Optional. Interpreter for the extraction engine's virtualenv. Defaults to
# engine/.venv/bin/python3; set this for a shared or containerised env.
# LOF2DATA_ENGINE_PYTHON=/path/to/python3

# Optional. Ollama daemon address. Defaults to http://localhost:11434.
# OLLAMA_HOST=http://localhost:11434

# Optional. Claude API key, to offer claude-sonnet-5-5 in the model selector.
# Without it the Claude option is shown greyed out. Pages sent to this model
# leave the machine and are billed to the key's account.
# ANTHROPIC_API_KEY=
